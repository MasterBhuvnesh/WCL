# Postgres connection used to look up participants, sessions, and results.
# Defaults to postgres://wcl:wcl@localhost:5432/wcl when unset.
DATABASE_URL=postgres://wcl:wcl@localhost:5432/wcl

# Exam whose publication flag gates candidates who never started a session.
# Defaults to WCL-EXAM when unset; must match EXAM_ID in the API's env.
EXAM_ID=WCL-EXAM
